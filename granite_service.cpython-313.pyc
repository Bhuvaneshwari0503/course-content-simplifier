"""
granite_service.py
------------------
Handles all communication with IBM Granite via IBM Watsonx.ai.
Builds structured prompts, calls the REST API, and parses JSON responses.
"""

import json
import re
import requests
from config import PROJECT_ID, API_KEY, ENDPOINT_URL, MODEL_ID


# ---------------------------------------------------------------------------
# IAM Token Helper
# ---------------------------------------------------------------------------

_iam_token_cache = {"token": None, "expires_at": 0}


def _get_iam_token() -> str:
    """
    Exchange the IBM Cloud API Key for a short-lived IAM Bearer token.
    Tokens are cached to avoid redundant round-trips.
    Raises a human-readable RuntimeError on failure.
    """
    import time

    # Return cached token if still valid (with 60-second buffer)
    if _iam_token_cache["token"] and time.time() < _iam_token_cache["expires_at"] - 60:
        return _iam_token_cache["token"]

    # Strip accidental whitespace/newlines from the key (common copy-paste issue)
    api_key_clean = API_KEY.strip()

    if not api_key_clean or api_key_clean == "Ew8R5yb89Flnh8-2ET3wDwSV4L4Dh4OjlblKdw-ZMUcYE":
        raise RuntimeError(
            "IBM API Key is not set. Open config.py and replace "
            "PASTE_API_KEY_HERE with your real IBM Cloud API Key."
        )

    iam_url = "https://iam.cloud.ibm.com/identity/token"
    headers = {"Content-Type": "application/x-www-form-urlencoded"}
    # Must be sent as form-encoded body, NOT JSON
    data = (
        "grant_type=urn%3Aibm%3Aparams%3Aoauth%3Agrant-type%3Aapikey"
        f"&apikey={requests.utils.quote(api_key_clean, safe='')}"
    )

    try:
        response = requests.post(iam_url, headers=headers, data=data, timeout=30)
    except requests.exceptions.ConnectionError:
        raise RuntimeError(
            "Cannot reach IBM IAM (iam.cloud.ibm.com). "
            "Check your internet connection."
        )
    except requests.exceptions.Timeout:
        raise RuntimeError("IBM IAM request timed out. Try again.")

    if response.status_code == 400:
        # Parse IBM's error body for a useful message
        try:
            err = response.json()
            reason = err.get("errorMessage") or err.get("errorCode") or err.get("error_description") or str(err)
        except Exception:
            reason = response.text[:300]
        raise RuntimeError(
            f"IBM IAM rejected the API key (400 Bad Request): {reason}. "
            "Please verify your API_KEY in config.py is correct and active."
        )

    if response.status_code == 401:
        raise RuntimeError(
            "IBM IAM returned 401 Unauthorized. "
            "Your API key may have been deleted or deactivated. "
            "Generate a new one at IBM Cloud → Manage → Access (IAM) → API Keys."
        )

    if not response.ok:
        raise RuntimeError(
            f"IBM IAM returned HTTP {response.status_code}: {response.text[:300]}"
        )

    token_data = response.json()

    if "access_token" not in token_data:
        raise RuntimeError(
            f"IBM IAM response did not contain an access_token. "
            f"Full response: {token_data}"
        )

    _iam_token_cache["token"] = token_data["access_token"]
    _iam_token_cache["expires_at"] = time.time() + token_data.get("expires_in", 3600)

    return _iam_token_cache["token"]


# ---------------------------------------------------------------------------
# Prompt Builder
# ---------------------------------------------------------------------------

LEVEL_DESCRIPTIONS = {
    "beginner": (
        "a complete beginner with no prior knowledge. "
        "Use very simple words, everyday analogies, and short sentences. "
        "Define every technical term. Avoid all jargon."
    ),
    "intermediate": (
        "a student who knows the basics. "
        "You may use common technical terms but explain advanced ones. "
        "Use relatable examples and a friendly tone."
    ),
    "advanced": (
        "an advanced learner comfortable with the subject. "
        "Retain technical vocabulary, provide deeper insight, "
        "and reference related concepts where helpful."
    ),
    "expert": (
        "a domain expert or researcher. "
        "Use precise academic/technical language, mention edge cases, "
        "and assume full familiarity with foundational concepts."
    ),
}

def _build_prompt(content: str, level: str) -> str:
    return f"""
You are a learning assistant.

Rewrite the following text for a {level} learner.

IMPORTANT:
- Explain only the content provided.
- Use simple language.
- Use one short paragraph.
- Maximum 150 words.
- Do not add new information.
- Do not repeat ideas.
- Do not give examples unless they already exist.
- Do not use bullet points.
- Do not use numbered lists.
- Do not write introductions or conclusions.
- Return only the rewritten text.

TEXT:
{content}
"""

# ---------------------------------------------------------------------------
# Watsonx.ai API Call
# ---------------------------------------------------------------------------

def _call_granite(prompt: str) -> str:
    """
    Send the prompt to IBM Granite via the Watsonx.ai /text/generation endpoint
    and return the raw generated text string.
    """
    token = _get_iam_token()

    url = f"{ENDPOINT_URL.rstrip('/')}/ml/v1/text/generation?version=2023-05-29"

    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "Accept": "application/json",
    }

    payload = {
        "model_id": MODEL_ID,
        "project_id": PROJECT_ID,
        "input": prompt,
        "parameters": {
            "decoding_method": "greedy",
            "max_new_tokens": 200,
            "min_new_tokens": 50,
            "stop_sequences": ["Here is the rewritten response:",
                "Key points to remember:",
                "In summary:"],
            "repetition_penalty": 1.05,
            "temperature": 0.3,
        },
    }

    response = requests.post(url, headers=headers, json=payload, timeout=60)

    print("\n=== WATSONX RESPONSE ===")
    print("Status:", response.status_code)
    print("Body:", response.text[:3000])
    print("========================\n")
    response.raise_for_status()

    result = response.json()
    generated_text = result["results"][0]["generated_text"]

    lines = generated_text.splitlines()

    if lines and (
        lines[0].startswith("and ")
        or lines[0].startswith("And ")
        or lines[0].startswith("or ")
        or lines[0].startswith("Or ")
    ):
        generated_text = "\n".join(lines[1:]).strip()

    # Remove common prefixes
    for prefix in [
        "rewritten response:",
        "Rewritten response:",
        "HERE IS THE REWRITTEN RESPONSE:",
        "Here is the rewritten response:",
        "here is the rewritten response:",
        "rewritten text:",
        "Rewritten text:",
    ]:
        generated_text = generated_text.replace(prefix, "")

    return generated_text.strip()

# ---------------------------------------------------------------------------
# JSON Parser
# ---------------------------------------------------------------------------

def _parse_json_response(raw: str) -> dict:
    import json
    import re

    try:
        # Remove markdown code blocks
        cleaned = raw.replace("```json", "").replace("```", "").strip()

        # Extract first JSON object
        start = cleaned.find("{")
        end = cleaned.rfind("}") + 1

        if start != -1 and end > start:
            return json.loads(cleaned[start:end])

    except Exception as e:
        print("JSON Parse Error:", e)

    return {
        "difficulty": "Unknown",
        "complexity_level": "Could not be determined",
        "concepts": [],
        "simplified_text": raw
    }

# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

def simplify_content(content: str, level: str) -> dict:
    """
    Main entry point called by Flask routes.

    Args:
        content: The raw educational text to simplify.
        level:   Target proficiency level — 'beginner', 'intermediate',
                 'advanced', or 'expert'.

    Returns:
        A dictionary with keys:
            difficulty      – original text difficulty rating
            complexity_level – descriptive phrase
            concepts        – list of key concepts (strings)
            simplified_text – rewritten content for the chosen level
    """
    if not content or not content.strip():
        raise ValueError("Content cannot be empty.")

    if level.lower() not in LEVEL_DESCRIPTIONS:
        raise ValueError(f"Invalid level '{level}'. Choose from: {list(LEVEL_DESCRIPTIONS)}")

    prompt = _build_prompt(content.strip(), level)
    raw_response = _call_granite(prompt)
    
    return {
        "simplified_text": raw_response.strip()
    }
